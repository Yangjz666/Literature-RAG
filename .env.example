# 选择模型提供方：openai 或 anthropic
LLM_PROVIDER=openai

# OpenAI-compatible 中转站配置，OPENAI_BASE_URL 通常需要包含 /v1
OPENAI_API_KEY=你的中转站APIKey
OPENAI_BASE_URL=https://你的中转站地址/v1
OPENAI_MODEL=模型名称

# Anthropic-compatible 中转站配置，ANTHROPIC_BASE_URL 通常不需要包含 /v1
ANTHROPIC_API_KEY=你的中转站APIKey
ANTHROPIC_BASE_URL=https://你的中转站地址
ANTHROPIC_MODEL=模型名称

# 向量索引使用 OpenAI-compatible /v1/embeddings。
# 如果你用 Anthropic 做问答，也仍然需要为 embedding 配置 OpenAI-compatible 通道。
EMBEDDING_API_KEY=你的中转站APIKey
EMBEDDING_BASE_URL=https://你的中转站地址/v1
EMBEDDING_MODEL=text-embedding-3-small
